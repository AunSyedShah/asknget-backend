# /opt/asknget/backend/.env: the backend's settings on this server. Created once by deploy/ec2/setup.sh (the __PLACEHOLDERS__ are
# filled in), never overwritten by a deploy, never committed. Every variable is documented in docs/environment.md.
# After editing: sudo systemctl restart asknget-web

SECRET_KEY=__SECRET_KEY__
DEBUG=0

# The address people type. If the server's public IP changes (it has no Elastic IP yet), update these three lines.
ALLOWED_HOSTS=__PUBLIC_HOST__,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://__PUBLIC_HOST__
STOREFRONT_URL=http://__PUBLIC_HOST__
PORTAL_URL=http://__PUBLIC_HOST__

# nginx is in front of the API on this box.
BEHIND_PROXY=1

FIELD_ENCRYPTION_KEY=__FIELD_ENCRYPTION_KEY__
DATABASE_URL=postgres://asknget:__DB_PASSWORD__@127.0.0.1:5432/asknget
DB_POOL=0

# Uploads live on this disk and nginx serves them (see deploy/ec2/nginx/asknget.conf).
FILE_STORAGE=filesystem
MEDIA_ROOT=/var/lib/asknget/media
SERVE_MEDIA=0

# South Africa is the launch market. The first deploy switches every other market off (manage.py set_markets);
# add more later with `manage.py set_markets ZA PK` or in Django admin (Countries).
DEFAULT_COUNTRY=ZA
ACTIVE_MARKETS=ZA

# Live products edited after approval stay live and are listed for staff (see docs/environment.md).
PRODUCT_EDIT_POLICY=flag

# Mail: without these, e-mail (OTP codes, order notices) is not delivered. Use an app password.
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=asknget <you@example.com>
