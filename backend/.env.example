# Copy to backend/.env and fill in. `.env` is git-ignored and is read by:
#   - Django directly when you run manage.py / `uv run poe ...` on your PC
#   - the db, web and worker containers via `env_file` in compose.yaml
#
# The *other* env file, at the repo root, configures Docker Compose itself
# (HTTP_PORT). Full reference: docs/environment.md

# --- Django -----------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=1
# Include the country subdomains, e.g. asknget.com,.asknget.com (za.asknget.com resolves the ZA market)
ALLOWED_HOSTS=localhost,.localhost,127.0.0.1
# Comma-separated, scheme included, when the API sits behind a domain/proxy:
# CSRF_TRUSTED_ORIGINS=https://api.asknget.com
# BEHIND_PROXY=1

# Required — encrypts ID/passport and bank account numbers at rest.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Postgres ---------------------------------------------------------------
# The db container creates this role + database on first start.
POSTGRES_USER=asknget
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=asknget

# Django connection string. Host is `db` inside Docker, `localhost` from your PC
# (the dev override publishes Postgres on 127.0.0.1:5432). Leave unset for SQLite.
DATABASE_URL=postgres://asknget:change-me-too@db:5432/asknget
# DATABASE_URL=postgres://asknget:change-me-too@localhost:5432/asknget

# --- Search & recommendations ----------------------------------------------
# hash = offline lexical embeddings (default, no key). For real semantic search
# set voyage (VOYAGE_API_KEY) or openai (OPENAI_API_KEY), then run
# `docker compose exec web python manage.py embed_products --all`.
# EMBEDDING_PROVIDER=hash
# EMBEDDING_MODEL=            # provider default: voyage-3.5-lite / text-embedding-3-small
# EMBEDDING_DIMENSIONS=512    # changing this needs a migration + --all re-embed
# VOYAGE_API_KEY=
# OPENAI_API_KEY=

# --- Advanced analytics (premium sellers) ----------------------------------
# ANALYTICS_EVENT_SCAN_LIMIT=5000   # rows the search-terms report scans before reporting `truncated`

# --- Optional tuning --------------------------------------------------------
# WEB_CONCURRENCY=3           # gunicorn workers (2 x CPU + 1 on a dedicated box; each ~100 MB RAM)
# GUNICORN_CMD_ARGS=--threads 2
# (HTTP_PORT, the port nginx publishes, is a compose variable: set it in your shell or a root .env)
# DB_POOL=1                   # psycopg connection pool (Postgres only); 0 to disable
# JWT_ACCESS_TTL_MINUTES=15
# JWT_REFRESH_TTL_DAYS=30
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=45
# OTP_MAX_ATTEMPTS=5
# STOREFRONT_URL=            # buyer site, for 'View Product' links in the seller portal
# ZEAL=1                      # arm the N+1 detector in a dev server (always on in tests)
# Fallback market when a request carries no region (bare domain, tests). Countries
# themselves (currency, timezone, languages, policies) are edited in Django admin.
# DEFAULT_COUNTRY=ZA
