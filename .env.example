# Repo-root .env — read by **Docker Compose itself**, not by Django.
#
#   cp .env.example .env
#
# Compose interpolates these into compose.yaml before any container starts, so
# they can only configure compose (ports, image tags, project name) — never the
# application. Django's own settings live in backend/.env.
#
# This file is committed; `.env` is git-ignored.

# Port nginx publishes on your machine. Windows reserves 80 for IIS/http.sys on
# many setups, so 8080 is the safe default here; the stack is then at
# http://localhost:8080/api/v1/docs
HTTP_PORT=8080

# Design tooling, not Docker: docs/figma/snapshot.py reads FIGMA_TOKEN from this file first, then from
# the environment (a token inherited from an app started before it was rotated is a common cause of
# 401s, so this file wins). Compose ignores it and it is never passed into a container: only
# backend/.env is. Personal access token, read-only file-content scope. Never commit the real file.
# FIGMA_TOKEN=
